{
  "id": "sipbb",
  "name": "Switzerland Innovation Park Biel/Bienne",
  "sites": [
    {
      "host": "sipbb.ch",
      "unit": "Switzerland Innovation Park Biel/Bienne",
      "seeds": [
        "https://sipbb.ch/services/",
        "https://sipbb.ch/research-technology/"
      ],
      "allow_paths": [
        "/services/",
        "/research-technology/",
        "/research/",
        "/consulting/"
      ]
    }
  ],
  "crawl": {
    "max_pages_per_site": 40,
    "delay_s": 1.0,
    "max_depth": 2
  },
  "page_types": [
    {
      "kind": "listing",
      "url_pattern": "^https://sipbb\\.ch/services/$"
    },
    {
      "kind": "space",
      "url_pattern": "^https://sipbb\\.ch/services/(sipbb_space|meeting-rooms)/$"
    },
    {
      "kind": "service",
      "url_pattern": "^https://sipbb\\.ch/(services/startup|consulting|research-technology|research)/$"
    },
    {
      "kind": "listing",
      "url_pattern": "^https://sipbb\\.ch/"
    }
  ]
}
