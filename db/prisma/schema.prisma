// The one schema for every lane. Names are snake_case in the database so the engine's raw SQL
// reads naturally. What Prisma cannot express (the vector extension, the HNSW index, the sha256
// check and the evidence-span trigger) is written by hand in the migration SQL; see db/README.md.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum ProfileKind {
  person
  unit
  project
  infrastructure

  @@map("profile_kind")
}

enum PageKind {
  person
  unit
  project
  infrastructure
  listing
  other

  @@map("page_kind")
}

enum Lang {
  de
  en
  fr
  it
  unknown

  @@map("lang")
}

enum ClaimField {
  name
  role
  unit
  expertise
  projects
  infrastructure
  services

  @@map("claim_field")
}

enum ClaimMethod {
  selector
  model

  @@map("claim_method")
}

enum TermKind {
  synonym
  lay
  translation
  acronym

  @@map("term_kind")
}

enum RelationKind {
  member_of
  leads
  part_of
  works_on
  operates

  @@map("relation_kind")
}

enum PlaceKind {
  institute
  platform
  centre

  @@map("place_kind")
}

enum PositionMethod {
  address
  district

  @@map("position_method")
}

model Source {
  id       String    @id
  name     String
  sites    Site[]
  pages    Page[]
  profiles Profile[]
  places   Place[]

  @@map("source")
}

model Site {
  host     String @id
  sourceId String @map("source_id")
  unit     String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("site")
}

model Page {
  url       String           @id
  sourceId  String           @map("source_id")
  unit      String
  fetchedAt DateTime         @map("fetched_at") @db.Timestamptz(3)
  sha256    String           @db.Char(64)
  status    Int
  lang      Lang?
  kind      PageKind?
  title     String?
  text      String
  source    Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  claims    Claim[]
  relations EntityRelation[]
  chunks    Chunk[]

  // Evidence points at a page version, not just a URL: a re-crawl that changes the text
  // must not silently re-label old spans as coming from the new text.
  @@unique([url, sha256])
  @@index([sourceId])
  @@map("page")
}

model Profile {
  id            String           @id
  kind          ProfileKind
  sourceId      String           @map("source_id")
  name          String
  sourceUrl     String           @map("source_url")
  source        Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  claims        Claim[]
  relationsFrom EntityRelation[] @relation("relation_from")
  relationsTo   EntityRelation[] @relation("relation_to")
  chunks        Chunk[]

  @@index([sourceId])
  @@map("profile")
}

model Claim {
  id         BigInt      @id @default(autoincrement())
  profileId  String      @map("profile_id")
  field      ClaimField
  position   Int
  value      String      @db.VarChar(200)
  method     ClaimMethod
  pageUrl    String      @map("page_url")
  pageSha256 String      @map("page_sha256") @db.Char(64)
  span       String      @db.VarChar(300)
  start      Int?
  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  page       Page        @relation(fields: [pageUrl, pageSha256], references: [url, sha256], onDelete: Cascade, onUpdate: Restrict)

  @@unique([profileId, field, position])
  @@index([pageUrl, pageSha256])
  @@map("claim")
}

model EntityRelation {
  id            BigInt       @id @default(autoincrement())
  fromProfileId String       @map("from_profile_id")
  toProfileId   String       @map("to_profile_id")
  kind          RelationKind
  method        ClaimMethod
  pageUrl       String       @map("page_url")
  pageSha256    String       @map("page_sha256") @db.Char(64)
  span          String       @db.VarChar(300)
  start         Int?
  fromProfile   Profile      @relation("relation_from", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile     Profile      @relation("relation_to", fields: [toProfileId], references: [id], onDelete: Cascade)
  page          Page         @relation(fields: [pageUrl, pageSha256], references: [url, sha256], onDelete: Cascade, onUpdate: Restrict)

  @@unique([fromProfileId, toProfileId, kind])
  @@index([toProfileId])
  @@index([pageUrl, pageSha256])
  @@map("entity_relation")
}

model Place {
  id                String         @id
  name              String
  sourceId          String         @map("source_id")
  host              String
  kind              PlaceKind
  address           String?
  addressUrl        String?        @map("address_url")
  addressSpan       String?        @map("address_span") @db.VarChar(300)
  addressFetchedAt  DateTime?      @map("address_fetched_at") @db.Timestamptz(3)
  addressPageSha256 String?        @map("address_page_sha256") @db.Char(64)
  x                 Float
  z                 Float
  positionMethod    PositionMethod @map("position_method")
  source            Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([host])
  @@map("place")
}

model Term {
  id            BigInt   @id @default(autoincrement())
  value         String
  term          String
  kind          TermKind
  lang          Lang?
  model         String
  promptVersion String   @map("prompt_version")

  @@unique([value, term, kind])
  @@map("term")
}

model Chunk {
  id        String                      @id
  profileId String?                     @map("profile_id")
  pageUrl   String                      @map("page_url")
  text      String
  embedding Unsupported("vector(384)")?
  tsv       Unsupported("tsvector")?
  profile   Profile?                    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  page      Page                        @relation(fields: [pageUrl], references: [url], onDelete: Cascade)

  @@index([profileId])
  @@index([pageUrl])
  @@index([tsv], map: "chunk_tsv_gin_idx", type: Gin)
  @@map("chunk")
}

model BundleLoad {
  id       BigInt   @id @default(autoincrement())
  version  String
  sha256   String   @db.Char(64)
  loadedAt DateTime @default(now()) @map("loaded_at") @db.Timestamptz(3)
  counts   Json

  @@map("bundle_load")
}

// Accounts (brief S1). Invite-only and self-hosted: no email is collected, passwords are argon2id
// hashes, and sessions and invite codes are stored only as SHA-256 hashes of the random value the
// person holds, so reading these tables cannot sign anyone in. Everything a person owns cascades
// from app_user, so deleting an account removes all of it.

enum ProfileVisibility {
  private
  members
  public
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  handle      String       @unique
  displayName String       @map("display_name")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  credential  Credential?
  sessions    Session[]
  profile     UserProfile?
  invitesMade Invite[]     @relation("invite_created_by")
  inviteUsed  Invite?      @relation("invite_used_by")
  memberships Member[]
  messages    Message[]

  // "user" is a reserved word in Postgres; every raw query would have to quote it.
  @@map("app_user")
}

model Credential {
  userId    String   @id @map("user_id") @db.Uuid
  hash      String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credential")
}

model Session {
  idHash    String   @id @map("id_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Invite {
  codeHash  String    @id @map("code_hash") @db.Char(64)
  createdBy String?   @map("created_by") @db.Uuid
  usedBy    String?   @unique @map("used_by") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  creator   User?     @relation("invite_created_by", fields: [createdBy], references: [id], onDelete: Cascade)
  redeemer  User?     @relation("invite_used_by", fields: [usedBy], references: [id], onDelete: SetNull)

  @@map("invite")
}

model UserProfile {
  userId     String            @id @map("user_id") @db.Uuid
  role       String?
  goal       String?
  expertise  String[]          @default([])
  visibility ProfileVisibility @default(private)
  avatar     Json?
  updatedAt  DateTime          @default(now()) @map("updated_at") @db.Timestamptz(3)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

// Failed sign-ins per handle and per IP, and sign-up attempts per IP, in fixed 15-minute windows.
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@map("rate_limit")
}

// Messages (brief S2). Only members of a conversation can read or post in it, and every query says
// so. Messages are never sent to a model, indexed for search or shown to the agent. A deleted
// message keeps its row (pagination stays stable) but loses its text.

enum ConversationKind {
  direct
  group
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  kind      ConversationKind
  title     String?
  // The two user ids, sorted and joined, so a pair has one direct conversation.
  directKey String?          @unique @map("direct_key")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  members   Member[]
  messages  Message[]

  @@map("conversation")
}

model Member {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadAt     DateTime?    @map("last_read_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("member")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  authorId       String       @map("author_id") @db.Uuid
  // At most 4,000 characters (a CHECK in the migration); emptied when the message is deleted.
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
  @@map("message")
}
