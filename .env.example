# Names only. Copy to .env and fill in locally; .env is gitignored and never shared.
DATABASE_URL=postgresql://bernlife:bernlife@127.0.0.1:5433/bernlife
ENGINE_PORT=8100
ENGINE_URL=http://127.0.0.1:8100

# Model endpoints (OpenAI-compatible). CSCS for the demo; a vLLM tunnel on 127.0.0.1 for smoke tests.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Apertus 70B route. When EXPAND_LLM_BASE_URL is set, every role (expand, enrich, extract, explain,
# brief) uses these three values together; LLM_* is used only while it is unset.
EXPAND_LLM_BASE_URL=
EXPAND_LLM_MODEL=
EXPAND_LLM_API_KEY=
# The web app's own origin; accounts refuse state-changing requests from any other.
APP_ORIGIN=
# live | replay | mock. Empty: live if an endpoint answers, else replay, else mock.
BERNLIFE_BACKEND=
# Live model calls in flight at once (default 4), so a batch cannot flood CSCS.
LLM_MAX_CONCURRENCY=
# Live model calls per UTC day; empty: none in serve (cache only), no cap for CLI commands.
LLM_CALL_BUDGET=
# 1 only behind a proxy that overwrites X-Forwarded-For (Caddy in infra/exoscale); else empty.
TRUST_PROXY=

HF_TOKEN=

# Crawl output and the bundle; default <repo>/data. Point all worktrees at one folder to share a crawl.
BERNLIFE_DATA_DIR=
