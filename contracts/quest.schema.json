{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quest.schema.json",
  "title": "Story",
  "description": "Story mode: a guided journey whose quests complete only on app events, never by self-report. Each quest names the case criterion it demonstrates.",
  "type": "object",
  "required": [
    "id",
    "title",
    "quests"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "criterion",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "goal": {
            "type": "string",
            "maxLength": 200
          },
          "criterion": {
            "enum": [
              "c1-right-people",
              "c2-wording",
              "c3-traceable",
              "c4-structured",
              "c5-sources",
              "c6-extend",
              "ethics-abstain",
              "stretch"
            ]
          },
          "optional": {
            "description": "Not needed to finish the story; its steps may complete in any order.",
            "type": "boolean"
          },
          "coming": {
            "description": "One line for the player: why the quest cannot be played yet. Shown while a step's event is not emitted by any feature.",
            "type": "string",
            "maxLength": 120
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "done_when"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 160
                },
                "hint": {
                  "description": "What the floatie says if the player asks.",
                  "type": "string",
                  "maxLength": 240
                },
                "done_when": {
                  "enum": [
                    "settled",
                    "office_ready",
                    "search_answered",
                    "search_answered_other_language",
                    "brief_answered",
                    "evidence_opened",
                    "report_made",
                    "lobby_entered",
                    "abstained_seen",
                    "source_added",
                    "numbers_seen",
                    "opportunity_saved",
                    "connection_saved",
                    "library_item_saved",
                    "message_sent",
                    "garage_visited"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
