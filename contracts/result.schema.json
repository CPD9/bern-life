{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "SearchResponse",
  "description": "What the engine returns for a query or a project brief (POST /api/search, POST /api/brief). The UI renders only this.",
  "type": "object",
  "required": [
    "query",
    "mode",
    "abstained",
    "results",
    "expanded_terms",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string"
    },
    "brief_terms": {
      "description": "For a brief: the needs Apertus read from it, each with the brief sentence it came from. Absent for a plain query.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "span"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string"
          },
          "span": {
            "type": "string"
          }
        }
      }
    },
    "mode": {
      "description": "live: a model answered now; replay: from the cache; mock: no model, canned text, the UI shows a MOCK banner.",
      "enum": [
        "live",
        "replay",
        "mock"
      ]
    },
    "abstained": {
      "type": "boolean"
    },
    "abstain_reason": {
      "enum": [
        "no_verifiable_source",
        "query_out_of_scope",
        "engine_error",
        null
      ]
    },
    "expanded_terms": {
      "description": "Retrieval terms added by enrichment and query expansion. Used for search only, never shown as a fact about a person.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "synonym",
              "lay",
              "translation",
              "acronym"
            ]
          },
          "lang": {
            "enum": [
              "de",
              "en",
              "fr",
              "it"
            ]
          }
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "profile",
          "reason",
          "score"
        ],
        "additionalProperties": false,
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "profile": {
            "$ref": "profile.schema.json"
          },
          "reason": {
            "description": "Why it matches, written only from the cited claims. `cites` are JSON pointers into `profile`, e.g. /fields/expertise/0.",
            "type": "object",
            "required": [
              "text",
              "cites"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "cites": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/(name|fields/[a-z]+/[0-9]+)$"
                }
              }
            }
          },
          "score": {
            "type": "object",
            "required": [
              "fused"
            ],
            "additionalProperties": false,
            "properties": {
              "fused": {
                "type": "number"
              },
              "lexical_rank": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "vector_rank": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "metrics": {
            "description": "Display only: describes a result, never reorders it. null means it could not be computed (shown as a dash, never 0). Computed from verified claims and pages, never from a model's opinion.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relevance",
              "covers",
              "missing",
              "evidence",
              "completeness",
              "novelty",
              "confidence"
            ],
            "properties": {
              "relevance": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "covers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "completeness": {
                "type": "object",
                "required": [
                  "filled",
                  "of"
                ],
                "additionalProperties": false,
                "properties": {
                  "filled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "of": {
                    "const": 5
                  }
                }
              },
              "novelty": {
                "type": "object",
                "required": [
                  "new_unit",
                  "adds"
                ],
                "additionalProperties": false,
                "properties": {
                  "new_unit": {
                    "type": "boolean"
                  },
                  "adds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "via": {
            "description": "When the result's own claims do not match the question but a related project or unit does: the relation (its verbatim span on its page) and the related profile's matching claims, inline, so both sentences are shown and checked.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "span",
              "page_url",
              "page_sha256",
              "related_profile_id",
              "related_name",
              "related_claims"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "leads",
                  "works_on",
                  "member_of"
                ]
              },
              "span": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "page_url": {
                "type": "string",
                "format": "uri"
              },
              "page_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "fetched_at": {
                "type": "string",
                "format": "date-time"
              },
              "related_profile_id": {
                "type": "string",
                "pattern": "^(person|unit|project|infrastructure)-[a-z0-9-]+$"
              },
              "related_name": {
                "type": "string",
                "minLength": 1
              },
              "related_claims": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "profile.schema.json#/$defs/claim"
                }
              }
            }
          },
          "passage": {
            "description": "When neither the result's own claims nor a related project's match the question, but its own page (the page its name claim cites) does, next to its name: the verbatim span from the name to the nearest matching word, within 300 characters and never across another profile's name. A passage on their page, not a claim of their profile; the reason stays the plain one from the profile's own claims.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "span",
              "page_url",
              "page_sha256",
              "start",
              "fetched_at"
            ],
            "properties": {
              "kind": {
                "const": "own_page"
              },
              "span": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "page_url": {
                "type": "string",
                "format": "uri"
              },
              "page_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "fetched_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "timings_ms": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "versions": {
      "type": "object",
      "required": [
        "engine",
        "snapshot",
        "prompts"
      ],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "prompts": {
          "type": "string"
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
