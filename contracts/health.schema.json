{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health.schema.json",
  "title": "Health",
  "description": "GET /api/health. The HUD shows only counts present here; a missing count is not shown, never guessed.",
  "type": "object",
  "required": [
    "mode",
    "snapshot",
    "counts"
  ],
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "live",
        "replay",
        "mock"
      ]
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "snapshot": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "profiles": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "status": {
      "description": "degraded when a model call failed in the last hour, or when the mode is live and today's call budget is used up.",
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "uptime_s": {
      "type": "integer",
      "minimum": 0
    },
    "failures_last_hour": {
      "description": "Failed model calls in the last hour, counted per role and failure marker. Markers only, never error text.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z0-9_]+$"
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget": {
      "description": "Live model calls allowed and used today (UTC day). Absent when the mode is not live.",
      "type": "object",
      "required": [
        "limit",
        "used"
      ],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "used": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
